{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prov-github-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
